SPRING_PROFILES_ACTIVE=dev
SERVER_PORT=8080
DB_URL=jdbc:mysql://localhost:3306/seckill?useUnicode=true&characterEncoding=utf8&serverTimezone=Asia/Shanghai&useSSL=false&allowPublicKeyRetrieval=true
DB_USERNAME=seckill
DB_PASSWORD=change-me
DB_POOL_MAX_SIZE=10
DB_POOL_MIN_IDLE=2
DB_CONNECTION_TIMEOUT_MS=30000
DB_VALIDATION_TIMEOUT_MS=5000
MYSQL_DATABASE=seckill
MYSQL_USER=seckill
MYSQL_PASSWORD=change-me
MYSQL_ROOT_PASSWORD=change-root-password
# Host port for Docker MySQL. Change this if local MySQL already uses 3306.
MYSQL_PORT=3306
LOG_DIR=./logs
